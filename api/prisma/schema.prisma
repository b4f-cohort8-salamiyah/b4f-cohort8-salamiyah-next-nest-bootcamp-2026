generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum ActivityAction {
  ISSUE_CREATED
  COMMENTED
  MENTIONED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  ISSUE_UPDATED
  STATUS_CHANGED
  ASSIGNED
  SPRINT_STARTED
  SPRINT_COMPLETED
}

enum NotificationType {
  MENTION
  MEMBER_ADDED
  WORKSPACE_ROLE_CHANGED
  ISSUE_ASSIGNED
  COMMENT_ON_REPORTED_OR_ASSIGNED_ISSUE
  SPRINT_STARTED
  SPRINT_COMPLETED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedWorkspaces     Workspace[]       @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  assignedIssues      Issue[]           @relation("IssueAssignee")
  reportedIssues      Issue[]           @relation("IssueReporter")
  comments            Comment[]
  activityEntries     ActivityLog[]     @relation("ActivityActor")
  notifications       Notification[]    @relation("NotificationRecipient")
  causedNotifications Notification[]    @relation("NotificationActor")

  @@map("users")
}

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  ownerId     Int      @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members  WorkspaceMember[]
  projects Project[]
  activity ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int           @map("workspace_id")
  userId      Int           @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Project {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  key         String   @unique
  name        String
  description String   @default("")
  issueSeq    Int      @default(0) @map("issue_seq")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]
  sprints   Sprint[]

  @@map("projects")
}

// Minimal agile-planning layer (Session 26, instructor-provided before 01-session-start).
// Real rules, stated explicitly, mirroring final-preview/b4f-board's own documented design:
//   1. Creating/starting/completing a sprint is Admin/Owner-only (same governance level as
//      creating a Project).
//   2. At most one ACTIVE sprint per project at a time -- enforced in the service layer, in a
//      transaction, the same real convention this codebase already uses for its other business
//      rules (e.g. "the workspace owner cannot be removed"), never a DB constraint.
//   3. A sprint only ever moves planned -> active -> completed, one step at a time, forward
//      only. A completed sprint can never become active again.
//   4. A completed sprint's name/goal can no longer be edited -- its history is closed once
//      finished.
model Sprint {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String
  goal        String    @default("")
  status      String    @default("planned")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // onDelete: SetNull, never Cascade -- deleting a sprint returns its issues to the Backlog
  // (sprintId null), never deletes them.
  issues  Issue[]

  @@map("sprints")
}

model Issue {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  key         String
  title       String
  description String   @default("")
  status      String   @default("todo")
  // Plain validated strings, the identical real convention `status` above already uses --
  // never a second Prisma enum concept introduced just for this field.
  priority    String   @default("medium") @map("priority")
  storyPoints Int?     @map("story_points")
  sprintId    Int?     @map("sprint_id")
  assigneeId  Int?     @map("assignee_id")
  reporterId  Int?     @map("reporter_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint        Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User?          @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments      Comment[]
  activity      ActivityLog[]
  notifications Notification[]

  @@unique([projectId, key])
  @@index([sprintId])
  @@map("issues")
}

model ActivityLog {
  id          Int            @id @default(autoincrement())
  workspaceId Int            @map("workspace_id")
  // Nullable: some real entries are workspace-level, not tied to one issue (none exist yet in
  // this app's own real action set, but the shape is deliberately kept open the same way
  // final-preview's own reference design does -- see DECISION-LOG.md's
  // b4f-board-agile-layer-scope-reversal entry).
  issueId     Int?           @map("issue_id")
  actorId     Int?           @map("actor_id")
  action      ActivityAction
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([issueId, createdAt])
  @@map("activity_logs")
}

model Comment {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  authorId  Int?     @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  issue         Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([issueId, createdAt])
  @@map("comments")
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int              @map("user_id")
  type    NotificationType
  message String

  issueId   Int? @map("issue_id")
  commentId Int? @map("comment_id")
  actorId   Int? @map("actor_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issue   Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
