// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  assignedIssues  Issue[]           @relation("IssueAssignee")
  reportedIssues  Issue[]           @relation("IssueReporter")

  @@map("users")
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members  WorkspaceMember[]
  projects Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int           @map("workspace_id")
  userId      Int           @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Project {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  key         String
  name        String
  description String   @default("")
  issueSeq    Int      @default(0) @map("issue_seq")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([workspaceId, key])
  @@map("projects")
}

model Issue {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  key        String
  title      String
  status     String   @default("todo")
  assigneeId Int?     @map("assignee_id")
  reporterId Int?     @map("reporter_id")
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User?   @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([projectId, key])
  @@map("issues")
}
